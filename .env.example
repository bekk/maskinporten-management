# Copy to .env and fill in the values. .env is gitignored.
#
# Nothing reads this file directly. scripts/dev.sh exports it, and the server then resolves the variables through
# the $ENV_VAR references in maskinporten-management-rest-server/src/main/resources/application.yaml (or the file in
# APPLICATION_CONFIG_FILE). Starting the server any other way - an IDE run configuration, a bare ./gradlew run -
# means putting these in the environment yourself.

# Required.

# Base URL of Digdir's API for managing Maskinporten scopes:
# - locally, the mock API in maskinporten-management-frontend-mock: http://localhost:8080
# - test: https://api.test.samarbeid.digdir.no
# - production: https://api.samarbeid.digdir.no
DIGDIR_BASE_URL=http://localhost:8080

# Maskinporten, which issues the tokens Digdir's API requires. Locally, the mock API plays Maskinporten too.
# - test: https://test.maskinporten.no/.well-known/oauth-authorization-server
# - production: https://maskinporten.no/.well-known/oauth-authorization-server
MASKINPORTEN_WELL_KNOWN_URL=http://localhost:8080/.well-known/oauth-authorization-server
# Our client at Digdir, and the scopes to ask for (space-separated).
MASKINPORTEN_CLIENT_ID=dev-client
MASKINPORTEN_SCOPES=idporten:scopes.write
# The business certificate chain in PEM, leaf first. It is public; its private key lives in Cloud KMS. Locally,
# scripts/setup-local-kms.sh in maskinporten-management-frontend-mock writes a fake one for a key it writes too.
MASKINPORTEN_CERTIFICATE_CHAIN_FILE=../maskinporten-management-frontend-mock/mock-api/local-kms/virksomhetssertifikat-chain.pem

# Where the certificate's private key is. Set exactly one of these:
# - KMS_KEY_VERSION: the Cloud KMS key version, in SKIP, where Workload Identity provides the credentials
#   (projects/<project>/locations/<location>/keyRings/<ring>/cryptoKeys/<key>/cryptoKeyVersions/<version>)
# - LOCAL_KMS_KEY_FILE: an RSA private key in PKCS#8 PEM, locally
KMS_KEY_VERSION=
LOCAL_KMS_KEY_FILE=../maskinporten-management-frontend-mock/mock-api/local-kms/virksomhetssertifikat.key

# Optional.

# Port the server listens on. The default is 8080, but the mock API uses that port.
PORT=8081

# The values below are the defaults.

# Access logging: one log line per HTTP request. true or false.
ACCESS_LOG_ENABLED=true

# Path to a logback.xml that replaces the bundled one.
LOGBACK_CONFIG_FILE=

# Path to an application.yaml that replaces the bundled one. The other variables here are only read if that file
# refers to them.
APPLICATION_CONFIG_FILE=
