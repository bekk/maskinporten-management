# Copy to .env and fill in the values. .env is gitignored.
#
# Nothing reads this file directly. scripts/dev.sh exports it, and the server then resolves the variables through
# the $ENV_VAR references in maskinporten-management-rest-server/src/main/resources/application.yaml (or the file in
# APPLICATION_CONFIG_FILE). Starting the server any other way - an IDE run configuration, a bare ./gradlew run -
# means putting these in the environment yourself.

# Required.

# Base URL of Digdir's API for managing Maskinporten scopes:
# - locally, the mock API in maskinporten-management-frontend-mock: http://localhost:8080
# - test: https://api.test.samarbeid.digdir.no
# - production: https://api.samarbeid.digdir.no
DIGDIR_BASE_URL=http://localhost:8080

# Filtering: lists like GET /api/scopes only show the scopes the calling app has access to. The server POSTs to
# EXTERNAL_FILTERING_URL with the caller's X-Forwarded-Client-Cert header, and gets back its exact scopes and prefixes.
# Filtering is on by default, and then EXTERNAL_FILTERING_URL is required. Set EXTERNAL_FILTERING_ENABLED=false to turn
# it off. There is nothing to filter against locally yet, so it is off here.
EXTERNAL_FILTERING_ENABLED=false
EXTERNAL_FILTERING_URL=

# Optional.

# Port the server listens on. The default is 8080, but the mock API uses that port.
PORT=8081

# The values below are the defaults.

# Access logging: one log line per HTTP request. true or false.
ACCESS_LOG_ENABLED=true

# Path to a logback.xml that replaces the bundled one.
LOGBACK_CONFIG_FILE=

# Path to an application.yaml that replaces the bundled one. The other variables here are only read if that file
# refers to them.
APPLICATION_CONFIG_FILE=
