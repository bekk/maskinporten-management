# Copy to .env and fill in the values. .env is gitignored. When you add or change a variable here, update the table in
# README.md too.
#
# Nothing reads this file directly. scripts/dev.sh exports it, and the server then resolves the variables through
# the $ENV_VAR references in maskinporten-management-rest-server/src/main/resources/application.yaml (or the file in
# APPLICATION_CONFIG_FILE). Starting the server any other way - an IDE run configuration, a bare ./gradlew run -
# means putting these in the environment yourself.

# Required to call Digdir. scripts/dev.sh runs the server with a fake Digdir instead, so locally these can stay empty.

# Which Digdir to talk to: TEST or PROD. It picks both Digdir's API for managing Maskinporten scopes and Maskinporten,
# which issues the tokens that API requires:
# - TEST: https://api.test.samarbeid.digdir.no and https://test.maskinporten.no
# - PROD: https://api.samarbeid.digdir.no and https://maskinporten.no
DIGDIR_ENVIRONMENT=

# Our client at Digdir. It asks for idporten:scopes.read and idporten:scopes.write, which Digdir's API requires to
# read scope access (GET /api/v1/scopes/access) and to change it.
MASKINPORTEN_CLIENT_ID=
# Our business certificate at Digdir, and its private key. DIGDIR_ADMIN_CERT_CHAIN is the certificate chain itself,
# in PEM, leaf first, not a path to a file. It is public; its private key lives in Cloud KMS.
DIGDIR_ADMIN_CERT_CHAIN=

# Where the certificate's private key is. Set exactly one of these. Both are paths, but to different kinds of places:
# - DIGDIR_ADMIN_GCP_CLOUD_KMS_KEY_PATH: the key in Cloud KMS, in SKIP, where Workload Identity provides the credentials:
#   projects/<project-id>/locations/<location>/keyRings/<key-ring-name>/cryptoKeys/<key-name>/cryptoKeyVersions/<key-version>
#   Whoever runs the server sets it. The path ends in a version, since the certificate is for that version's public key.
# - DIGDIR_ADMIN_LOCAL_KEY_PATH: a file with an RSA private key in PKCS#8 PEM
DIGDIR_ADMIN_GCP_CLOUD_KMS_KEY_PATH=
DIGDIR_ADMIN_LOCAL_KEY_PATH=

# Filtering: lists like GET /api/scopes and GET /api/scopeaccess/scopes only show the scopes the calling app has
# access to. The server POSTs to EXTERNAL_FILTERING_URL with the caller's X-Forwarded-Client-Cert header, and gets
# back its exact scopes and prefixes. Filtering is off by default, and then the server warns at startup and lists show
# all scopes. Set EXTERNAL_FILTERING_ENABLED=true to turn it on. Locally, scripts/dev.sh runs the server with a fake
# filtering service, which answers in place of the URL below.
EXTERNAL_FILTERING_ENABLED=false
EXTERNAL_FILTERING_URL=http://fake-filtering.local

# Optional. The values below are the defaults.

# Port the server listens on.
PORT=8080

# How many seconds the server remembers what each caller has access to, so a change can take that long to show. 0
# turns it off. Only answers from the filtering service that went well are remembered.
EXTERNAL_FILTERING_CACHE_SECONDS=60

# Access logging: one log line per HTTP request. true or false.
ACCESS_LOG_ENABLED=true

# Whether the access log also has a line for each call to the health endpoints, such as the
# platform's liveness probe. true or false. Only applies when ACCESS_LOG_ENABLED is true.
ACCESS_LOG_HEALTH_ENABLED=false

# Path to a logback.xml that replaces the bundled one.
LOGBACK_CONFIG_FILE=

# Path to an application.yaml that replaces the bundled one. The other variables here are only read if that file
# refers to them.
APPLICATION_CONFIG_FILE=
