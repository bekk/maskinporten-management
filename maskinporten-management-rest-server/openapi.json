{
    "openapi": "3.1.1",
    "info": {
        "title": "Maskinporten Management REST API",
        "version": "v0",
        "description": "Manages Kartverket's Maskinporten scopes through Digdir's API: lists the scopes, and lists, gives and removes\norganisations' access to them.\n\nA call only reaches this API after the platform has checked that the calling app may make it. When a list\nholds scopes, it only shows the ones the calling app has access to. Answers use Digdir's field names, but only\nhold the fields described here: a field Digdir adds later is left out. When Digdir answers with an error, this\nAPI returns that answer unchanged: its status, body and content type."
    },
    "paths": {
        "/health/live": {
            "get": {
                "summary": "Liveness probe",
                "description": "Returns 200 OK if the server is up. Not part of the stable API.",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/scopes": {
            "get": {
                "summary": "List Kartverket's scopes that the calling app has access to",
                "description": "Asks Digdir for Kartverket's active scopes, and returns the ones the calling app has access to: the scopes in\nits `exact` list, and the ones that start with one of its prefixes. The platform tells this API which app is\ncalling, in the `X-Forwarded-Client-Cert` header.\n\nWhen Digdir answers with an error, that answer is returned unchanged.",
                "parameters": [
                    {
                        "name": "X-Forwarded-Client-Cert",
                        "in": "header",
                        "description": "Says which app is calling. The platform sets it on every call, so the app does not.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "default": {
                        "description": "Any other status is Digdir's own answer, passed on unchanged in Digdir's error format. The exception is a `500` with `code` `INTERNAL_ERROR`, which is an unexpected error in this API."
                    },
                    "200": {
                        "description": "The scopes the calling app has access to. The list is empty if it has access to none.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ScopeDetails"
                                    }
                                },
                                "examples": {
                                    "Scopes": {
                                        "value": [
                                            {
                                                "name": "kartverk:tilgangsstyring/demo.read",
                                                "prefix": "kartverk",
                                                "subscope": "tilgangsstyring/demo.read",
                                                "description": "Lesetilgang til demo-API-et",
                                                "active": true,
                                                "created": "2026-01-15T09:30:00Z",
                                                "last_updated": "2026-01-15T09:30:00Z",
                                                "allowed_integration_types": [
                                                    "maskinporten"
                                                ],
                                                "owner_orgno": "971040238",
                                                "token_type": "SELF_CONTAINED",
                                                "visibility": "PUBLIC",
                                                "requires_user_consent": false,
                                                "requires_user_authentication": false,
                                                "requires_pseudonymous_tokens": false,
                                                "at_max_age": 120,
                                                "authorization_max_lifetime": 0,
                                                "accessible_for_all": false,
                                                "protected": false,
                                                "supports_european_businesses": false
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The `X-Forwarded-Client-Cert` header is missing, so this API cannot tell which app is calling. Digdir can also answer `400`, in its own error format.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "MissingClientCertificate": {
                                        "value": {
                                            "error": "Header X-Forwarded-Client-Cert is required",
                                            "code": "INVALID_REQUEST"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "This API could not get an answer from Digdir, or from the service that says which scopes the calling app has access to. Your request did not cause it.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "UpstreamError": {
                                        "value": {
                                            "error": "The call to Digdir failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    },
                                    "FilteringError": {
                                        "value": {
                                            "error": "The call to the filtering service failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/scopeaccess/orgs": {
            "get": {
                "summary": "List the organisations that have access to a scope",
                "description": "Asks Digdir which organisations Kartverket has given access to `scope`. When Digdir answers with an error, that answer is returned unchanged.",
                "parameters": [
                    {
                        "name": "scope",
                        "in": "query",
                        "description": "The scope, for example `kartverk:matrikkel.read`. It must be the only query parameter, sent once.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "default": {
                        "description": "Any other status is Digdir's own answer, passed on unchanged in Digdir's error format. The exception is a `500` with `code` `INTERNAL_ERROR`, which is an unexpected error in this API."
                    },
                    "200": {
                        "description": "The organisations given access to the scope. Check `state`: only `APPROVED` means access.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ScopeAccess"
                                    }
                                },
                                "examples": {
                                    "Consumers": {
                                        "value": [
                                            {
                                                "scope": "kartverk:matrikkel.read",
                                                "owner_orgno": "971040238",
                                                "owner_organization_name": "STATENS KARTVERK",
                                                "consumer_orgno": "311718371",
                                                "consumer_organization_name": "EKSEMPEL AS",
                                                "state": "APPROVED",
                                                "created": "2026-01-15T09:30:00Z",
                                                "last_updated": "2026-01-15T09:30:00Z"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The query is not exactly one `scope`, or `scope` is blank or not URL-encoded correctly. Digdir can also answer `400`, in its own error format.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "MissingScope": {
                                        "value": {
                                            "error": "Query parameter scope is required",
                                            "code": "INVALID_REQUEST"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "This API could not get an answer from Digdir. Your request did not cause it.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "UpstreamError": {
                                        "value": {
                                            "error": "The call to Digdir failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/scopeaccess/scopes": {
            "get": {
                "summary": "List the scopes an organisation has access to",
                "description": "Asks Digdir which of Kartverket's scopes `orgnr` has access to, and returns the ones the calling app has\naccess to: the scopes in its `exact` list, and the ones that start with one of its prefixes. The platform tells\nthis API which app is calling, in the `X-Forwarded-Client-Cert` header.\n\nWhen Digdir answers with an error, that answer is returned unchanged.",
                "parameters": [
                    {
                        "name": "orgnr",
                        "in": "query",
                        "description": "The consumer's organisation number: 9 digits, for example `311718371`. It must be the only query parameter, sent once.",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9]{9}$"
                        }
                    },
                    {
                        "name": "X-Forwarded-Client-Cert",
                        "in": "header",
                        "description": "Says which app is calling. The platform sets it on every call, so the app does not.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "default": {
                        "description": "Any other status is Digdir's own answer, passed on unchanged in Digdir's error format. The exception is a `500` with `code` `INTERNAL_ERROR`, which is an unexpected error in this API."
                    },
                    "200": {
                        "description": "The organisation's access to the scopes the calling app has access to. Check `state`: only `APPROVED` means access. The list is empty if there is none.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ScopeAccess"
                                    }
                                },
                                "examples": {
                                    "Scopes": {
                                        "value": [
                                            {
                                                "scope": "kartverk:matrikkel.read",
                                                "owner_orgno": "971040238",
                                                "owner_organization_name": "STATENS KARTVERK",
                                                "consumer_orgno": "311718371",
                                                "consumer_organization_name": "EKSEMPEL AS",
                                                "state": "APPROVED",
                                                "created": "2026-01-15T09:30:00Z",
                                                "last_updated": "2026-01-15T09:30:00Z"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The query is not exactly one `orgnr`, or `orgnr` is not 9 digits, or the `X-Forwarded-Client-Cert` header is missing. Digdir can also answer `400`, in its own error format.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "InvalidOrganisationNumber": {
                                        "value": {
                                            "error": "Query parameter orgnr must be an organisation number of 9 digits",
                                            "code": "INVALID_REQUEST"
                                        }
                                    },
                                    "MissingClientCertificate": {
                                        "value": {
                                            "error": "Header X-Forwarded-Client-Cert is required",
                                            "code": "INVALID_REQUEST"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "This API could not get an answer from Digdir, or from the service that says which scopes the calling app has access to. Your request did not cause it.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "UpstreamError": {
                                        "value": {
                                            "error": "The call to Digdir failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    },
                                    "FilteringError": {
                                        "value": {
                                            "error": "The call to the filtering service failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/scopeaccess/{consumerOrgno}": {
            "put": {
                "summary": "Give an organisation access to a scope",
                "description": "Asks Digdir to give `consumerOrgno` access to `scope`. When Digdir answers with an error, that answer is returned unchanged.",
                "parameters": [
                    {
                        "name": "consumerOrgno",
                        "in": "path",
                        "description": "The consumer's organisation number: 9 digits, for example `311718371`.",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9]{9}$"
                        }
                    },
                    {
                        "name": "scope",
                        "in": "query",
                        "description": "The scope, for example `kartverk:matrikkel.read`. It must be the only query parameter, sent once.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "default": {
                        "description": "Any other status is Digdir's own answer, passed on unchanged in Digdir's error format. The exception is a `500` with `code` `INTERNAL_ERROR`, which is an unexpected error in this API."
                    },
                    "200": {
                        "description": "The access that was given.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ScopeAccess"
                                },
                                "examples": {
                                    "GivenAccess": {
                                        "value": {
                                            "scope": "kartverk:matrikkel.read",
                                            "owner_orgno": "971040238",
                                            "owner_organization_name": "STATENS KARTVERK",
                                            "consumer_orgno": "311718371",
                                            "consumer_organization_name": "EKSEMPEL AS",
                                            "state": "APPROVED",
                                            "created": "2026-01-15T09:30:00Z",
                                            "last_updated": "2026-01-15T09:30:00Z"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "`consumerOrgno` is not 9 digits, or the query is not exactly one `scope`, or `scope` is blank or not URL-encoded correctly. Digdir can also answer `400`, in its own error format.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "InvalidOrganisationNumber": {
                                        "value": {
                                            "error": "Path parameter consumerOrgno must be an organisation number of 9 digits",
                                            "code": "INVALID_REQUEST"
                                        }
                                    },
                                    "MissingScope": {
                                        "value": {
                                            "error": "Query parameter scope is required",
                                            "code": "INVALID_REQUEST"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "This API could not get an answer from Digdir. Your request did not cause it.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "UpstreamError": {
                                        "value": {
                                            "error": "The call to Digdir failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "summary": "Remove an organisation's access to a scope",
                "description": "Asks Digdir to remove the access `consumerOrgno` has to `scope`. Digdir keeps the access as inactive, so it no longer shows up in this API's lists. When Digdir answers with an error, that answer is returned unchanged.",
                "parameters": [
                    {
                        "name": "consumerOrgno",
                        "in": "path",
                        "description": "The consumer's organisation number: 9 digits, for example `311718371`.",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9]{9}$"
                        }
                    },
                    {
                        "name": "scope",
                        "in": "query",
                        "description": "The scope, for example `kartverk:matrikkel.read`. It must be the only query parameter, sent once.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "default": {
                        "description": "Any other status is Digdir's own answer, passed on unchanged in Digdir's error format. The exception is a `500` with `code` `INTERNAL_ERROR`, which is an unexpected error in this API."
                    },
                    "200": {
                        "description": "The access that was removed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ScopeAccess"
                                },
                                "examples": {
                                    "RemovedAccess": {
                                        "value": {
                                            "scope": "kartverk:matrikkel.read",
                                            "owner_orgno": "971040238",
                                            "owner_organization_name": "STATENS KARTVERK",
                                            "consumer_orgno": "311718371",
                                            "consumer_organization_name": "EKSEMPEL AS",
                                            "state": "APPROVED",
                                            "created": "2026-01-15T09:30:00Z",
                                            "last_updated": "2026-01-15T09:30:00Z"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "`consumerOrgno` is not 9 digits, or the query is not exactly one `scope`, or `scope` is blank or not URL-encoded correctly. Digdir can also answer `400`, in its own error format.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "InvalidOrganisationNumber": {
                                        "value": {
                                            "error": "Path parameter consumerOrgno must be an organisation number of 9 digits",
                                            "code": "INVALID_REQUEST"
                                        }
                                    },
                                    "MissingScope": {
                                        "value": {
                                            "error": "Query parameter scope is required",
                                            "code": "INVALID_REQUEST"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "This API could not get an answer from Digdir. Your request did not cause it.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "UpstreamError": {
                                        "value": {
                                            "error": "The call to Digdir failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ScopeDetails": {
                "type": "object",
                "title": "ScopeDetails",
                "required": [
                    "name",
                    "prefix",
                    "subscope",
                    "description",
                    "active",
                    "created",
                    "last_updated",
                    "allowed_integration_types",
                    "owner_orgno",
                    "token_type",
                    "visibility",
                    "requires_user_consent",
                    "requires_user_authentication",
                    "requires_pseudonymous_tokens",
                    "at_max_age",
                    "authorization_max_lifetime",
                    "accessible_for_all",
                    "protected",
                    "supports_european_businesses"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "The whole scope: the prefix, a colon and the subscope."
                    },
                    "prefix": {
                        "type": "string",
                        "description": "Digdir's prefix for the owner, `kartverk` for Kartverket: only the part before the colon."
                    },
                    "subscope": {
                        "type": "string",
                        "description": "The part after the colon, which the owner chose. It cannot be changed."
                    },
                    "description": {
                        "type": "string",
                        "description": "A short description in Norwegian Bokmål."
                    },
                    "long_description": {
                        "type": "string",
                        "description": "A longer description in Norwegian Bokmål. Left out, or empty, if the owner has not written one."
                    },
                    "description#en": {
                        "type": "string",
                        "description": "`description` in English. Left out if the owner has not written one."
                    },
                    "description#nn": {
                        "type": "string",
                        "description": "`description` in Norwegian Nynorsk. Left out if the owner has not written one."
                    },
                    "long_description#en": {
                        "type": "string",
                        "description": "`long_description` in English. Left out if the owner has not written one."
                    },
                    "long_description#nn": {
                        "type": "string",
                        "description": "`long_description` in Norwegian Nynorsk. Left out if the owner has not written one."
                    },
                    "active": {
                        "type": "boolean",
                        "description": "Always `true` here, since only active scopes are listed."
                    },
                    "created": {
                        "type": "string",
                        "description": "When the scope was created.",
                        "format": "date-time"
                    },
                    "last_updated": {
                        "type": "string",
                        "description": "When the scope was last changed.",
                        "format": "date-time"
                    },
                    "allowed_integration_types": {
                        "type": "array",
                        "description": "The kinds of client that can use the scope. A Maskinporten client needs `maskinporten`, or an empty list, which allows every kind. `unknown` is a kind Digdir has added that this API does not know yet.",
                        "items": {
                            "type": "string",
                            "enum": [
                                "ansattporten",
                                "api_klient",
                                "eformidling",
                                "idporten",
                                "idporten_saml2",
                                "krr",
                                "maskinporten",
                                "unknown"
                            ]
                        }
                    },
                    "owner_orgno": {
                        "type": "string",
                        "description": "The organisation that owns the scope: Kartverket."
                    },
                    "token_type": {
                        "type": "string",
                        "description": "The kind of access token issued for the scope.\n\n- `SELF_CONTAINED`: a JWT that the API can verify itself. Maskinporten only issues these.\n- `OPAQUE`: a token that the API has to look up with Digdir.\n- `UNKNOWN`: a kind Digdir has added that this API does not know yet.",
                        "enum": [
                            "SELF_CONTAINED",
                            "OPAQUE",
                            "UNKNOWN"
                        ]
                    },
                    "visibility": {
                        "type": "string",
                        "description": "Who can see the scope.\n\n- `PUBLIC`: anyone, in Digdir's list of all scopes.\n- `PRIVATE`: only the owner and the organisations given access.\n- `INTERNAL`: Digdir's own use.\n- `UNKNOWN`: a value Digdir has added that this API does not know yet.",
                        "enum": [
                            "INTERNAL",
                            "PRIVATE",
                            "PUBLIC",
                            "UNKNOWN"
                        ]
                    },
                    "requires_user_consent": {
                        "type": "boolean",
                        "description": "Only for logins with ID-porten, not for Maskinporten: a person must consent before a client gets a token."
                    },
                    "requires_user_authentication": {
                        "type": "boolean",
                        "description": "Only for logins with ID-porten, not for Maskinporten: a person must log in again, even with an active session."
                    },
                    "requires_pseudonymous_tokens": {
                        "type": "boolean",
                        "description": "Only for logins with ID-porten, not for Maskinporten: tokens leave out the person's national identity number."
                    },
                    "delegation_source": {
                        "type": "string",
                        "description": "Where an organisation with access can delegate it to a supplier, such as `https://www.altinn.no/`. Left out when the scope cannot be delegated."
                    },
                    "at_max_age": {
                        "type": "integer",
                        "description": "The most seconds an access token for the scope can live. `0` means Digdir's default."
                    },
                    "authorization_max_lifetime": {
                        "type": "integer",
                        "description": "The most seconds an authorization for the scope can live. `0` means Digdir's default."
                    },
                    "accessible_for_all": {
                        "type": "boolean",
                        "description": "If `true`, every organisation can get tokens for the scope without being given access."
                    },
                    "enforced_aud_for_access_token": {
                        "type": "string",
                        "description": "Digdir does not document this field."
                    },
                    "protected": {
                        "type": "boolean",
                        "description": "Digdir does not document this field."
                    },
                    "supports_european_businesses": {
                        "type": "boolean",
                        "description": "Digdir does not document this field. Its name matches Digdir's feature that lets European businesses get tokens with an eIDAS seal, without being given access."
                    }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "title": "ErrorResponse",
                "required": [
                    "error",
                    "code"
                ],
                "properties": {
                    "error": {
                        "type": "string",
                        "description": "A short summary for people to read. The wording may change, so check `code` in your code."
                    },
                    "code": {
                        "type": "string",
                        "description": "What went wrong. These values do not change, so your code can rely on them.\n\n- `INVALID_REQUEST` (400): the request was refused before it reached Digdir. `error` says why.\n- `UPSTREAM_ERROR` (502): this API could not get an answer from Digdir, or from the service that says\n  which scopes the calling app has access to. Your request did not cause it.\n- `INTERNAL_ERROR` (500): an unexpected error in this API.",
                        "enum": [
                            "INVALID_REQUEST",
                            "UPSTREAM_ERROR",
                            "INTERNAL_ERROR"
                        ]
                    }
                }
            },
            "ScopeAccess": {
                "type": "object",
                "title": "ScopeAccess",
                "required": [
                    "scope",
                    "owner_orgno",
                    "consumer_orgno",
                    "state",
                    "created",
                    "last_updated"
                ],
                "properties": {
                    "scope": {
                        "type": "string",
                        "description": "The scope."
                    },
                    "owner_orgno": {
                        "type": "string",
                        "description": "The organisation that owns the scope: Kartverket."
                    },
                    "owner_organization_name": {
                        "type": "string",
                        "description": "The name of the organisation that owns the scope. Left out when Digdir has no name for it."
                    },
                    "consumer_orgno": {
                        "type": "string",
                        "description": "The organisation that was given access."
                    },
                    "consumer_organization_name": {
                        "type": "string",
                        "description": "The name of the organisation that was given access. Left out when Digdir has no name for it."
                    },
                    "state": {
                        "type": "string",
                        "description": "Where the access stands. Only `APPROVED` means the organisation has access, and giving access through this API sets it at once. Digdir does not document when it uses `REQUESTED` and `DENIED`. `UNKNOWN` is a state Digdir has added that this API does not know yet.",
                        "enum": [
                            "REQUESTED",
                            "APPROVED",
                            "DENIED",
                            "UNKNOWN"
                        ]
                    },
                    "created": {
                        "type": "string",
                        "description": "When the access was given.",
                        "format": "date-time"
                    },
                    "last_updated": {
                        "type": "string",
                        "description": "When the access was last changed.",
                        "format": "date-time"
                    }
                }
            }
        }
    }
}
