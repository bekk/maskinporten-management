{
    "openapi": "3.1.1",
    "info": {
        "title": "Maskinporten Management REST API",
        "version": "0.1.0",
        "description": "REST API for managing Maskinporten scopes"
    },
    "paths": {
        "/health/live": {
            "get": {
                "summary": "Liveness probe",
                "description": "Returns 200 OK if the server is up. Not part of the stable API.",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/scopes": {
            "get": {
                "summary": "List Kartverket's scopes that the calling app has access to",
                "description": "Asks Digdir for Kartverket's active scopes, and returns the ones the calling app has access to: the scopes in\nits `exact` list, and the ones that start with one of its prefixes. Istio tells this API which app is calling,\nin the `X-Forwarded-Client-Cert` header.\n\nEach scope is Digdir's, unchanged. When Digdir answers with an error, that answer is returned unchanged.",
                "responses": {
                    "default": {
                        "description": "Any other status is Digdir's own answer, passed on unchanged in Digdir's error format. The exception is a `500` with `code` `INTERNAL_ERROR`, which is an unexpected error in this API."
                    },
                    "200": {
                        "description": "The scopes the calling app has access to. The list is empty if it has access to none.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Scope"
                                    }
                                },
                                "examples": {
                                    "Scopes": {
                                        "value": [
                                            {
                                                "name": "kartverk:tilgangsstyring/demo.read",
                                                "prefix": "kartverk",
                                                "subscope": "tilgangsstyring/demo.read",
                                                "description": "Lesetilgang til demo-API-et",
                                                "active": true,
                                                "created": "2026-01-15T09:30:00Z",
                                                "last_updated": "2026-01-15T09:30:00Z",
                                                "allowed_integration_types": [
                                                    "maskinporten"
                                                ],
                                                "owner_orgno": "971040238",
                                                "token_type": "SELF_CONTAINED",
                                                "visibility": "PUBLIC",
                                                "requires_user_consent": false,
                                                "requires_user_authentication": false,
                                                "requires_pseudonymous_tokens": false,
                                                "at_max_age": 120,
                                                "authorization_max_lifetime": 0,
                                                "accessible_for_all": false,
                                                "protected": false,
                                                "supports_european_businesses": false
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The `X-Forwarded-Client-Cert` header is missing, so this API cannot tell which app is calling. Digdir can also answer `400`, in its own error format.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "MissingClientCertificate": {
                                        "value": {
                                            "error": "Header X-Forwarded-Client-Cert is required",
                                            "code": "INVALID_REQUEST"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "This API could not get an answer from Digdir, or from the service that says which scopes the calling app has access to. Your request did not cause it.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "UpstreamError": {
                                        "value": {
                                            "error": "The call to Digdir failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    },
                                    "FilteringError": {
                                        "value": {
                                            "error": "The call to the filtering service failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/scopeaccess/orgs": {
            "get": {
                "summary": "List the organisations that have access to a scope",
                "description": "Asks Digdir which organisations Kartverket has given access to `scope`. Digdir's response is returned unchanged, with its status, body and content type, including when Digdir answers with an error.",
                "parameters": [
                    {
                        "name": "scope",
                        "in": "query",
                        "description": "The scope, for example `kartverk:matrikkel.read`. It must be the only query parameter, sent once.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "default": {
                        "description": "Any other status is Digdir's own answer, passed on unchanged in Digdir's error format. The exception is a `500` with `code` `INTERNAL_ERROR`, which is an unexpected error in this API."
                    },
                    "200": {
                        "description": "Digdir's answer: the organisations given access to the scope. Check `state`: only `APPROVED` means access, and an organisation that has only asked for access, or was refused, may be listed too.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ScopeAccess"
                                    }
                                },
                                "examples": {
                                    "Consumers": {
                                        "value": [
                                            {
                                                "scope": "kartverk:matrikkel.read",
                                                "owner_orgno": "971040238",
                                                "owner_organization_name": "STATENS KARTVERK",
                                                "consumer_orgno": "311718371",
                                                "consumer_organization_name": "EKSEMPEL AS",
                                                "state": "APPROVED",
                                                "created": "2026-01-15T09:30:00Z",
                                                "last_updated": "2026-01-15T09:30:00Z"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The query is not exactly one `scope`, or `scope` is blank or not URL-encoded correctly. Digdir can also answer `400`, in its own error format.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "MissingScope": {
                                        "value": {
                                            "error": "Query parameter scope is required",
                                            "code": "INVALID_REQUEST"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "This API could not get an answer from Digdir. Your request did not cause it.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "UpstreamError": {
                                        "value": {
                                            "error": "The call to Digdir failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/scopeaccess/scopes": {
            "get": {
                "summary": "List the scopes an organisation has access to",
                "description": "Asks Digdir which of Kartverket's scopes `orgnr` has access to, and returns the ones the calling app has\naccess to: the scopes in its `exact` list, and the ones that start with one of its prefixes. Istio tells this\nAPI which app is calling, in the `X-Forwarded-Client-Cert` header.\n\nEach access is Digdir's, unchanged. When Digdir answers with an error, that answer is returned unchanged.",
                "parameters": [
                    {
                        "name": "orgnr",
                        "in": "query",
                        "description": "The consumer's organisation number: 9 digits, for example `311718371`. It must be the only query parameter, sent once.",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9]{9}$"
                        }
                    }
                ],
                "responses": {
                    "default": {
                        "description": "Any other status is Digdir's own answer, passed on unchanged in Digdir's error format. The exception is a `500` with `code` `INTERNAL_ERROR`, which is an unexpected error in this API."
                    },
                    "200": {
                        "description": "The organisation's access to the scopes the calling app has access to. Check `state`: only `APPROVED` means access, and a scope the organisation has only asked for, or was refused, may be listed too. The list is empty if there is none.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ScopeAccess"
                                    }
                                },
                                "examples": {
                                    "Scopes": {
                                        "value": [
                                            {
                                                "scope": "kartverk:matrikkel.read",
                                                "owner_orgno": "971040238",
                                                "owner_organization_name": "STATENS KARTVERK",
                                                "consumer_orgno": "311718371",
                                                "consumer_organization_name": "EKSEMPEL AS",
                                                "state": "APPROVED",
                                                "created": "2026-01-15T09:30:00Z",
                                                "last_updated": "2026-01-15T09:30:00Z"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The query is not exactly one `orgnr`, or `orgnr` is not 9 digits, or the `X-Forwarded-Client-Cert` header is missing. Digdir can also answer `400`, in its own error format.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "InvalidOrganisationNumber": {
                                        "value": {
                                            "error": "Query parameter orgnr must be an organisation number of 9 digits",
                                            "code": "INVALID_REQUEST"
                                        }
                                    },
                                    "MissingClientCertificate": {
                                        "value": {
                                            "error": "Header X-Forwarded-Client-Cert is required",
                                            "code": "INVALID_REQUEST"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "This API could not get an answer from Digdir, or from the service that says which scopes the calling app has access to. Your request did not cause it.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "UpstreamError": {
                                        "value": {
                                            "error": "The call to Digdir failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    },
                                    "FilteringError": {
                                        "value": {
                                            "error": "The call to the filtering service failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/scopeaccess/{consumerOrgno}": {
            "put": {
                "summary": "Give an organisation access to a scope",
                "description": "Asks Digdir to give `consumerOrgno` access to `scope`. Digdir's response is returned unchanged, with its status, body and content type, including when Digdir answers with an error.",
                "parameters": [
                    {
                        "name": "consumerOrgno",
                        "in": "path",
                        "description": "The consumer's organisation number: 9 digits, for example `311718371`.",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9]{9}$"
                        }
                    },
                    {
                        "name": "scope",
                        "in": "query",
                        "description": "The scope, for example `kartverk:matrikkel.read`. It must be the only query parameter, sent once.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "default": {
                        "description": "Any other status is Digdir's own answer, passed on unchanged in Digdir's error format. The exception is a `500` with `code` `INTERNAL_ERROR`, which is an unexpected error in this API."
                    },
                    "200": {
                        "description": "Digdir's answer: the access that was given.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ScopeAccess"
                                },
                                "examples": {
                                    "GivenAccess": {
                                        "value": {
                                            "scope": "kartverk:matrikkel.read",
                                            "owner_orgno": "971040238",
                                            "owner_organization_name": "STATENS KARTVERK",
                                            "consumer_orgno": "311718371",
                                            "consumer_organization_name": "EKSEMPEL AS",
                                            "state": "APPROVED",
                                            "created": "2026-01-15T09:30:00Z",
                                            "last_updated": "2026-01-15T09:30:00Z"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "`consumerOrgno` is not 9 digits, or the query is not exactly one `scope`, or `scope` is blank or not URL-encoded correctly. Digdir can also answer `400`, in its own error format.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "InvalidOrganisationNumber": {
                                        "value": {
                                            "error": "Path parameter consumerOrgno must be an organisation number of 9 digits",
                                            "code": "INVALID_REQUEST"
                                        }
                                    },
                                    "MissingScope": {
                                        "value": {
                                            "error": "Query parameter scope is required",
                                            "code": "INVALID_REQUEST"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "This API could not get an answer from Digdir. Your request did not cause it.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "UpstreamError": {
                                        "value": {
                                            "error": "The call to Digdir failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "summary": "Remove an organisation's access to a scope",
                "description": "Asks Digdir to remove the access `consumerOrgno` has to `scope`. Digdir's response is returned unchanged, with its status, body and content type, including when Digdir answers with an error.",
                "parameters": [
                    {
                        "name": "consumerOrgno",
                        "in": "path",
                        "description": "The consumer's organisation number: 9 digits, for example `311718371`.",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9]{9}$"
                        }
                    },
                    {
                        "name": "scope",
                        "in": "query",
                        "description": "The scope, for example `kartverk:matrikkel.read`. It must be the only query parameter, sent once.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "default": {
                        "description": "Any other status is Digdir's own answer, passed on unchanged in Digdir's error format. The exception is a `500` with `code` `INTERNAL_ERROR`, which is an unexpected error in this API."
                    },
                    "200": {
                        "description": "Digdir's answer: the access that was removed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ScopeAccess"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "`consumerOrgno` is not 9 digits, or the query is not exactly one `scope`, or `scope` is blank or not URL-encoded correctly. Digdir can also answer `400`, in its own error format.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "InvalidOrganisationNumber": {
                                        "value": {
                                            "error": "Path parameter consumerOrgno must be an organisation number of 9 digits",
                                            "code": "INVALID_REQUEST"
                                        }
                                    },
                                    "MissingScope": {
                                        "value": {
                                            "error": "Query parameter scope is required",
                                            "code": "INVALID_REQUEST"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "This API could not get an answer from Digdir. Your request did not cause it.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "UpstreamError": {
                                        "value": {
                                            "error": "The call to Digdir failed",
                                            "code": "UPSTREAM_ERROR"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Scope": {
                "type": "object",
                "title": "Scope",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "The whole scope: the prefix, a colon and the subscope."
                    },
                    "prefix": {
                        "type": "string"
                    },
                    "subscope": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "long_description": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "descriptions": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "active": {
                        "type": "boolean",
                        "description": "Always `true` here, since only active scopes are listed."
                    },
                    "created": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "last_updated": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "allowed_integration_types": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "ansattporten",
                                "api_klient",
                                "eformidling",
                                "idporten",
                                "idporten_saml2",
                                "krr",
                                "maskinporten"
                            ]
                        }
                    },
                    "owner_orgno": {
                        "type": "string",
                        "description": "The organisation that owns the scope: Kartverket."
                    },
                    "token_type": {
                        "type": "string",
                        "enum": [
                            "SELF_CONTAINED",
                            "OPAQUE"
                        ]
                    },
                    "visibility": {
                        "type": "string",
                        "enum": [
                            "INTERNAL",
                            "PRIVATE",
                            "PUBLIC"
                        ]
                    },
                    "requires_user_consent": {
                        "type": "boolean"
                    },
                    "requires_user_authentication": {
                        "type": "boolean"
                    },
                    "requires_pseudonymous_tokens": {
                        "type": "boolean"
                    },
                    "delegation_source": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "at_max_age": {
                        "type": "integer",
                        "description": "The most seconds an access token for the scope can live."
                    },
                    "authorization_max_lifetime": {
                        "type": "integer",
                        "description": "The most seconds an authorization for the scope can live."
                    },
                    "accessible_for_all": {
                        "type": "boolean"
                    },
                    "enforced_aud_for_access_token": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "protected": {
                        "type": "boolean"
                    },
                    "supports_european_businesses": {
                        "type": "boolean"
                    }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "title": "ErrorResponse",
                "required": [
                    "error",
                    "code"
                ],
                "properties": {
                    "error": {
                        "type": "string",
                        "description": "A short summary for people to read. The wording may change, so check `code` in your code."
                    },
                    "code": {
                        "type": "string",
                        "description": "What went wrong. These values do not change, so your code can rely on them.\n\n- `INVALID_REQUEST` (400): the request was refused before it reached Digdir. `error` says why.\n- `UPSTREAM_ERROR` (502): this API could not get an answer from Digdir, or from the service that says\n  which scopes the calling app has access to. Your request did not cause it.\n- `INTERNAL_ERROR` (500): an unexpected error in this API.",
                        "enum": [
                            "INVALID_REQUEST",
                            "MALFORMED_BODY",
                            "UPSTREAM_ERROR",
                            "INTERNAL_ERROR"
                        ]
                    }
                }
            },
            "ScopeAccess": {
                "type": "object",
                "title": "ScopeAccess",
                "properties": {
                    "scope": {
                        "type": "string",
                        "description": "The scope."
                    },
                    "owner_orgno": {
                        "type": "string",
                        "description": "The organisation that owns the scope: Kartverket."
                    },
                    "owner_organization_name": {
                        "type": "string"
                    },
                    "consumer_orgno": {
                        "type": "string",
                        "description": "The organisation that was given access."
                    },
                    "consumer_organization_name": {
                        "type": "string"
                    },
                    "state": {
                        "type": "string",
                        "description": "Where the access stands. Only `APPROVED` means the organisation has access.\n\n- `REQUESTED`: the organisation has asked for access.\n- `APPROVED`: the organisation has access.\n- `DENIED`: the request for access was refused.",
                        "enum": [
                            "REQUESTED",
                            "APPROVED",
                            "DENIED"
                        ]
                    },
                    "created": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "last_updated": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        }
    }
}
